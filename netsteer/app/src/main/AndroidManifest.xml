<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Probes and in-app downloads. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Read Network/NetworkCapabilities/LinkProperties, register NetworkCallbacks. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- requestNetwork(): keep cellular up while Wi-Fi is the system default (hot standby). -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Keep the failover loop alive while the UI is closed. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Deliberately NOT requested: ACCESS_FINE_LOCATION (only needed to read SSID/BSSID),
      BIND_VPN_SERVICE (only for the optional Mode B flow-steering design, see README),
      any privileged/signature permission (unavailable to third-party apps).
    -->

    <application
        android:name=".NetSteerApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".MonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuous network health monitoring and failover between Wi-Fi and cellular for this app's traffic" />
        </service>
    </application>
</manifest>
