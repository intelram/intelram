<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only; trust system CAs only (no user-installed CAs), so a TLS-intercepting
     middlebox shows up as a diagnosis instead of being silently trusted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
